# cad-assist script
units mm
skill enclosure width=95 depth=65 height=30 wall=2 lid standoffs name=pi_case
box 10 30 8 name=sd_port2
translate -2 18 14 target=sd_port2
subtract pi_case_base sd_port2 name=pi_case_base
delete sd_port2
box 70 3 10 name=vent1
translate 12 63 8 target=vent1
subtract pi_case_base vent1 name=pi_case_base
box 70 3 10 name=vent2
translate 12 63 15 target=vent2
subtract pi_case_base vent2 name=pi_case_base
skill gear teeth=24 module=2 bore=5 thickness=6 name=part1
box 80 80 4 name=plate
circle 32 name=face
translate 40 40 target=face
role engrave target=face
circle 10 name=eye_l
translate 28 50 target=eye_l
role engrave target=eye_l
circle 10 name=eye_r
translate 52 50 target=eye_r
role engrave target=eye_r
circle 6 name=nose
translate 40 34 target=nose
role engrave target=nose
path 30 28 40 24 50 28 name=mouth
role engrave target=mouth
text "GORILLA" h=8 align=center name=label
translate 40 8 target=label
role engrave target=label
translate 0 0 4 target=face
translate 0 0 4 target=eye_l
translate 0 0 4 target=eye_r
translate 0 0 4 target=nose
translate 0 0 4 target=mouth
translate 0 0 4 target=label
circle 4 name=nostril_l
translate 36 32 target=nostril_l
translate 0 0 4 target=nostril_l
role engrave target=nostril_l
circle 4 name=nostril_r
translate 44 32 target=nostril_r
translate 0 0 4 target=nostril_r
role engrave target=nostril_r
circle 14 name=brow
translate 40 52 target=brow
translate 0 0 4 target=brow
role engrave target=brow
skill boxjoint width=80 depth=60 height=40 thickness=3 finger=10 lid=true gap=10
extrude 3 target=box_bottom name=stl_bottom
extrude 3 target=box_front name=stl_front
extrude 3 target=box_back name=stl_back
extrude 3 target=box_left name=stl_left
extrude 3 target=box_right name=stl_right
extrude 3 target=box_lid name=stl_lid
group stl_bottom stl_front stl_back stl_left stl_right stl_lid name=box_parts
